# Copy this file to .env and fill in the values.
# .env is git-ignored - never commit real secrets.
# The worker reads exactly these variables (see internal/config/config.go).

# -- Redis (must match the API's REDIS_PASSWORD) -------------------------------
REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=

# -- Object storage (screenshots). Must match the API's STORAGE_* settings ----
# STORAGE_ENDPOINT=localhost:9000
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=nabu-files
# STORAGE_USE_SSL=false

# -- AI fallback (optional) ----------------------------------------------------
# Used by the cookie-banner / compliance scanners when static detection fails.
# AI_PROVIDER selects the backend: "claude" | "gemini" | auto (default).
# Auto: uses Claude if ANTHROPIC_API_KEY is set, else Gemini.
# AI_PROVIDER=gemini
# ANTHROPIC_API_KEY=            # https://console.anthropic.com/
# GEMINI_API_KEY=               # https://aistudio.google.com/

# -- Worker tuning -------------------------------------------------------------
# WORKER_MAX_CONCURRENT=10        # parallel scans (clamped to NABU_MAX_CONCURRENT_CHROME when Chrome is available)
# NABU_MAX_CONCURRENT_CHROME=3    # simultaneous headless tabs (each uses ~150-300 MB RAM)

# -- Optional integrations -----------------------------------------------------
# NABU_CHROME_PATH=/usr/bin/google-chrome-stable   # auto-detected when unset
# NABU_FLARESOLVERR_URL=http://localhost:8191
# NABU_PROXY_DE=http://proxy:8080                  # per-region proxy, NABU_PROXY_<REGION>
