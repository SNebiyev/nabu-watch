# nabu-watch - environment configuration
# Copy this to .env and fill in all values.
# Generate secrets with: openssl rand -base64 32
#
# This file is committed to git as a reference template.
# .env is git-ignored - NEVER commit real secrets.
#
# docker-compose.prod.yml reads this file. For local development with `./gradlew bootRun`
# put the same variables (at least JWT_SECRET) in .env.local instead.

# ── Domain ────────────────────────────────────────────────────────────────────
# Public hostname Caddy serves (no scheme). Defaults to "localhost" if unset.
DOMAIN=localhost
# Public base URL of the UI (used in emails, CORS, OAuth redirects). Defaults to https://${DOMAIN}.
# FRONTEND_URL=https://localhost
# Public base URL used in links the API generates. Defaults to https://${DOMAIN}.
# NABU_BASE_URL=https://localhost

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_NAME=nabu_watch
DB_USER=nabu
# REQUIRED — openssl rand -base64 32
DB_PASS=

# ── Redis ─────────────────────────────────────────────────────────────────────
# REQUIRED — openssl rand -base64 32
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED, no default: the API refuses to start without it (min 32 chars: openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# ── First admin ───────────────────────────────────────────────────────────────
# Register normally with this email (or sign in with Google/GitHub). The account is promoted
# to ADMIN as soon as the email is verified. Unverified accounts are never promoted.
# Leave empty to disable.
NABU_BOOTSTRAP_ADMIN_EMAIL=

# ── Storage (MinIO / S3) ─────────────────────────────────────────────────────
STORAGE_PROVIDER=minio
# REQUIRED — openssl rand -hex 16
STORAGE_ACCESS_KEY=
# REQUIRED — openssl rand -base64 32
STORAGE_SECRET_KEY=
STORAGE_BUCKET=nabu-files

# ── Mail (SMTP) ──────────────────────────────────────────────────────────────
# Any SMTP relay works (Resend, SES, Postmark, your own server). For local development
# point at Mailpit: MAIL_HOST=localhost, MAIL_PORT=1025, MAIL_AUTH=false, MAIL_STARTTLS=false.
MAIL_HOST=localhost, MAIL_PORT=1025, MAIL_AUTH=false
#   (b) use the shared Resend API key from the team vault
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
# SMTP password / API key
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=noreply@example.com
# Contact shown to site owners in abuse/appeal emails (defaults to MAIL_FROM).
# ABUSE_EMAIL=
# Comma-separated addresses notified on every new signup (optional).
# ADMIN_NOTIFY_EMAILS=

# ── OAuth2 ────────────────────────────────────────────────────────────────────
# Google: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://{DOMAIN}/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers
# Callback URL: https://{DOMAIN}/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Scan limits (all optional; defaults shown) ───────────────────────────────
# SCAN_DOMAIN_COOLDOWN_MINUTES=15        # min gap between scans of the same hostname
# SCAN_MANUAL_COOLDOWN_MINUTES=30        # min gap between manual rescans of one website
# SCAN_DEFAULT_INTERVAL_MINUTES=1440     # default scheduled-scan interval
# SCAN_HISTORY_LIMIT=90                  # scan results kept per website
# PENDING_VERIFICATION_LIMIT=5           # unverified websites per user per window (0 disables)
# PENDING_VERIFICATION_WINDOW_DAYS=30

# ── Frontend (NEXT_PUBLIC_* are baked into the UI build: rebuild after changing) ─
NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_SITE_URL=                # defaults to https://${DOMAIN}
# NEXT_PUBLIC_SITE_NAME=               # defaults to "nabu-watch"
# NEXT_PUBLIC_SUPPORT_EMAIL=           # must be an ADMIN account's email to receive in-app support messages
# NEXT_PUBLIC_ABUSE_EMAIL=             # shown to owners of paused sites (defaults to the support email)

# ── Analytics (optional, off when unset) ──────────────────────────────────────
# Point at your own Umami instance (the host is not part of this compose stack). If it is on
# another host, also add that host to script-src in deploy/Caddyfile.
NEXT_PUBLIC_UMAMI_HOST=
# Umami dashboard -> website settings (UUID)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ── Grafana / Loki (log UI at https://logs.${DOMAIN}) ─────────────────────────
# REQUIRED by docker-compose.prod.yml - openssl rand -base64 24
GRAFANA_PASSWORD=

# ── Optional integrations (API) ───────────────────────────────────────────────
# GEMINI_API_KEY=                      # AI remediation suggestions on security findings
# TOOLS_TURNSTILE_ENABLED=false        # Cloudflare Turnstile on the public scan tools
# TOOLS_TURNSTILE_SECRET_KEY=          # (site key: NEXT_PUBLIC_TURNSTILE_SITE_KEY)

# ── Go worker (runs on the host via systemd, not in compose) ──────────────────
# Config lives in /opt/nabu-worker/.env - see nabu-worker/.env.example.
# docker-compose.prod.yml publishes Redis on 127.0.0.1:6379 and MinIO on 127.0.0.1:9000 so
# the host worker can reach them: set REDIS_ADDR=localhost:6379 and the same REDIS_PASSWORD
# and STORAGE_* values there.
