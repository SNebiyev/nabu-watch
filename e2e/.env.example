# Copy to .env and adjust if your local stack differs from defaults.
UI_URL=http://localhost:3000
API_URL=http://localhost:8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=nabu_watch
DB_USER=postgres
DB_PASS=admin

# Stable test user credentials — recreated on every global-setup run.
E2E_ADMIN_EMAIL=e2e-admin@nabu.test
E2E_ADMIN_PASSWORD=E2eAdminPass!23
E2E_DEMO_EMAIL=e2e-demo@nabu.test
E2E_DEMO_PASSWORD=E2eDemoPass!23
E2E_SECONDARY_EMAIL=e2e-secondary@nabu.test
E2E_SECONDARY_PASSWORD=E2eSecondary!23

# Optional — if running CI, set to 1 to fail instead of reusing cached auth state.
E2E_FRESH_AUTH=0


# Only for migrated/phase5f: must equal the JWT_SECRET the API under test runs with.
# E2E_JWT_SECRET=
